{
  "name": "iit-phd-personal-website",
  "version": "1.0.0",
  "description": "Professional personal website with separated frontend and backend code.",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "check": "node scripts/check.js",
    "security:check": "node scripts/security-audit.js",
    "security:history": "node scripts/security-audit.js --history",
    "backup": "node scripts/content-snapshot.js",
    "test": "node --test backend/*.test.js frontend/*.test.js scripts/*.test.js",
    "build": "node scripts/build-static.js",
    "test:browser": "node scripts/browser-check.js",
    "images": "node scripts/optimize-images.js",
    "audit:public": "node scripts/audit-public.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "ws": "^8.22.2"
  }
}
